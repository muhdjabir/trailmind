# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Tavily web search API key (free tier) - used by search_web for
# destinations outside KNOWN_DESTINATIONS. Sign up at https://tavily.com
TAVILY_API_KEY=

# Supabase Auth (step 23a) - Project Settings > API in your Supabase project.
# The anon key is meant for the browser, but keep it here rather than in code.
# Leave both empty to run without sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
